# ---------------------------------------------------------------------------
# AXTRA frontend — environment variables (prefix NEXT_PUBLIC_)
# The browser no longer talks to Supabase; all data goes through the backend.
# ---------------------------------------------------------------------------

# Axtra FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set to 1 to call the API through the Next.js rewrite /api-proxy (same-origin).
# Keep this on so the HttpOnly session cookie is sent automatically.
NEXT_PUBLIC_API_PROXY=1