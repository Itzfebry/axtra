{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/main.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,scripts/**,**/*.test.py,**/__pycache__/**,.venv/**,.pytest_cache/**,.ruff_cache/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "0 14 * * *"
    }
  ]
}
