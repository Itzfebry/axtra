# ---------------------------------------------------------------------------
# AXTRA backend — environment variables
# ---------------------------------------------------------------------------

# App
APP_ENV=development
APP_NAME=Axtra API
CORS_ORIGINS=http://localhost:3000

# Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Single-user auth
# One shared password. SESSION_SECRET signs the HttpOnly session cookie.
# scripts/setup-env.ps1 generates both if they are missing from the root .env.
APP_PASSWORD=choose-a-strong-password
SESSION_SECRET=random-32-byte-secret
OWNER_USER_ID=00000000-0000-0000-0000-000000000001
SESSION_TTL_HOURS=720

# Groq
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Comma-separated fallback list. First entry is the default router model.
GROQ_CHAT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Embeddings: none | huggingface
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
HUGGINGFACE_API_KEY=

# Memory retrieval
MEMORY_RETRIEVAL_COUNT=6
MEMORY_MIN_SIMILARITY=0.25
MEMORY_EXTRACTION_ENABLED=true

# Guardrails
MAX_CONTEXT_MESSAGES=20
RATE_LIMIT_PER_MINUTE=30
READ_RATE_LIMIT_PER_MINUTE=300

# Token usage display (denominators for the navbar/sidebar meters; 0 = hide)
MODEL_TPM_LIMIT=8000
MODEL_DAILY_TOKEN_LIMIT=200000

# Document attachments (Document chat mode)
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENT_CHARS=12000
