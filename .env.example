# ---------------------------------------------------------------------------
# AXTRA — referensi environment variables
# Salin file ini menjadi .env (root) dan isi nilai sebenarnya.
# scripts/setup-env.ps1 menurunkan backend/.env dan frontend/.env.local dari sini.
# ---------------------------------------------------------------------------

# App / CORS (origin frontend yang diizinkan memanggil backend langsung)
APP_ENV=development
APP_NAME=Axtra API
CORS_ORIGINS=http://localhost:3000

# Supabase (backend memakai service role; browser tidak lagi mengakses Supabase)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=xxxxxxxxxxxx

# Migrasi otomatis (pilih salah satu; dipakai scripts/migrate.ps1 / migrate_api.py)
# A. DB password (Project Settings -> Database -> Connection string URI)
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# B. Personal access token (Dashboard -> Account -> Access Tokens)
SUPABASE_ACCESS_TOKEN=

# Single-user auth
# Satu kata sandi untuk login; SESSION_SECRET menandatangani cookie sesi.
# Jika kosong, scripts/setup-env.ps1 akan membuat dan menambahkannya otomatis.
APP_PASSWORD=choose-a-strong-password
SESSION_SECRET=random-32-byte-secret
OWNER_USER_ID=00000000-0000-0000-0000-000000000001
SESSION_TTL_HOURS=720

# Groq
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Embeddings (semantic memory). 'none' = keyword search only.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
HUGGINGFACE_API_KEY=

# Memory retrieval & extraction
MEMORY_RETRIEVAL_COUNT=6
MEMORY_MIN_SIMILARITY=0.25
MEMORY_EXTRACTION_ENABLED=true

# Guardrails
MAX_CONTEXT_MESSAGES=20
RATE_LIMIT_PER_MINUTE=30
READ_RATE_LIMIT_PER_MINUTE=300
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENT_CHARS=12000

# Web research (mode Riset Web): crawl halaman jadi konteks chat.
RESEARCH_MAX_CHARS=12000
RESEARCH_MAX_SOURCES=5
RESEARCH_FETCH_TIMEOUT=15
RESEARCH_MAX_BYTES=2097152

# GitHub repo indexing (RAG kode proyek). Token kosong = repo publik saja (60 req/jam).
# Isi file dibaca via raw.githubusercontent.com (tak makan kuota API); API hanya
# untuk metadata + struktur. Set GITHUB_TOKEN untuk 5000 req/jam + repo privat.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
REPO_INDEX_MAX_FILES=300
REPO_INDEX_MAX_FILE_BYTES=200000
REPO_INDEX_MAX_CHUNKS=4000
REPO_INDEX_CHUNK_CHARS=1200
REPO_INDEX_CHUNK_OVERLAP=200
REPO_QA_CONTEXT_CHUNKS=8

# Ringkasan AI proyek: muat ulang otomatis setelah data proyek berubah.
PROJECT_HEALTH_AUTO_REFRESH=true
PROJECT_HEALTH_DEBOUNCE_SECONDS=12

# Token usage meter (0 = sembunyikan limit/persentase)
MODEL_TPM_LIMIT=8000
MODEL_DAILY_TOKEN_LIMIT=200000

# Telegram (dipakai mulai Phase 4, disiapkan sejak awal)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token